rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Pillar 1 & Phase 4.1: Global Safety Net (Default-Deny Catch-All)
    match /{document=**} {
      allow read, write: if false;
    }

    // Phase 3: Reusable Hardened Global Helpers
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isVerifiedUser() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        request.auth.token.email == 'mazharhajid@gmail.com'
      );
    }

    // Pillar 2: Validation Blueprint for StudentGradeRecord
    function isValidGradeRecord(data) {
      return data.keys().hasAll([
          'studentName',
          'nis',
          'halaqah',
          'semester',
          'kategoriPenilaian',
          'nahwu',
          'shorof',
          'durusulLughah',
          'hadis',
          'adab',
          'catatanUstadz',
          'ownerId',
          'ownerName',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'studentName',
          'nis',
          'halaqah',
          'semester',
          'kategoriPenilaian',
          'nahwu',
          'shorof',
          'durusulLughah',
          'hadis',
          'adab',
          'catatanUstadz',
          'ownerId',
          'ownerName',
          'createdAt',
          'updatedAt'
        ]) &&
        data.studentName is string && data.studentName.size() >= 1 && data.studentName.size() <= 100 &&
        data.nis is string && data.nis.size() >= 1 && data.nis.size() <= 30 && data.nis.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.halaqah is string && data.halaqah.size() >= 1 && data.halaqah.size() <= 60 &&
        data.semester is string && data.semester.size() >= 1 && data.semester.size() <= 40 &&
        data.semester in ['Ganjil 1447 H', 'Genap 1447 H', 'Ganjil 1448 H', 'Genap 1448 H'] &&
        data.kategoriPenilaian is string && data.kategoriPenilaian.size() >= 1 && data.kategoriPenilaian.size() <= 40 &&
        data.kategoriPenilaian in ['Ujian Akhir (UAS)', 'Ujian Tengah (UTS)', 'Ikhtibar Syahri', 'Rekap Semester'] &&
        data.nahwu is number && data.nahwu >= 0 && data.nahwu <= 100 &&
        data.shorof is number && data.shorof >= 0 && data.shorof <= 100 &&
        data.durusulLughah is number && data.durusulLughah >= 0 && data.durusulLughah <= 100 &&
        data.hadis is number && data.hadis >= 0 && data.hadis <= 100 &&
        data.adab is number && data.adab >= 0 && data.adab <= 100 &&
        data.catatanUstadz is string && data.catatanUstadz.size() >= 0 && data.catatanUstadz.size() <= 500 &&
        data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128 &&
        data.ownerId.matches('^[a-zA-Z0-9_\\-]+$') && data.ownerId == request.auth.uid &&
        data.ownerName is string && data.ownerName.size() >= 1 && data.ownerName.size() <= 100 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isEditGradeAction() {
      return existing().ownerId == request.auth.uid &&
        incoming().ownerId == existing().ownerId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time;
    }

    match /gradeRecords/{recordId} {
      allow get: if isSignedIn() && isValidId(recordId) && existing().ownerId == request.auth.uid;
      allow list: if isSignedIn() && existing().ownerId == request.auth.uid;

      allow create: if isVerifiedUser() &&
        isValidId(recordId) &&
        isValidGradeRecord(incoming()) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;

      allow update: if isVerifiedUser() &&
        isValidId(recordId) &&
        isValidGradeRecord(incoming()) && (
          isAdmin() ||
          (
            isEditGradeAction() &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'studentName',
              'nis',
              'halaqah',
              'semester',
              'kategoriPenilaian',
              'nahwu',
              'shorof',
              'durusulLughah',
              'hadis',
              'adab',
              'catatanUstadz',
              'ownerName',
              'updatedAt'
            ])
          )
        );

      allow delete: if isVerifiedUser() &&
        isValidId(recordId) &&
        (existing().ownerId == request.auth.uid || isAdmin());
    }

    match /admins/{adminId} {
      allow get: if isVerifiedUser() && isValidId(adminId) && (request.auth.uid == adminId || isAdmin());
      allow list: if false;
      allow create, update, delete: if false;
    }
  }
}
